# Copy to .env and fill in. Never share or commit .env. Leave a value empty to keep the default.

# ---- LegalListen website
# Gemini API key: enables LLM mode + server speech recognition (each client opts in).
GEMINI_API_KEY=
# gemini | anthropic | openai | none   (default: gemini if a key is set)
LEGALLISTEN_LLM=
# Model id (default gemini-2.5-flash)
LEGALLISTEN_MODEL=
# Fernet key for encryption at rest (auto-generated into data/legallisten if empty)
LEGALLISTEN_SECRET_KEY=
LEGALLISTEN_RETENTION_DAYS=30
LEGALLISTEN_RATE_PER_MIN=90

# ---- LexVaani-IN dataset pipeline (optional LLM paraphrase / judge)
LLM_PROVIDER=gemini
GEN_MODEL=
JUDGE_PROVIDER=
JUDGE_MODEL=
